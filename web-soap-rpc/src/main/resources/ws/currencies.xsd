<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:tns="http://example.com/web-soap-rpc/gen/currencies"
    targetNamespace="http://example.com/web-soap-rpc/gen/currencies"
           elementFormDefault="qualified">

    <xs:complexType name="wsCurrency">
        <xs:sequence>
            <xs:element name="prefix" type="xs:string"/>
            <xs:element name="name" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:element name="getCurrencyByPrefixRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="prefix" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="getCurrencyByPrefixResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="currency" type="tns:wsCurrency"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>
